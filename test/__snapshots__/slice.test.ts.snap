exports[`react-tailwind example > writes the AGENTS.md design section 1`] = `
"<!-- brandrails:start -->
## Design system

Generated by Brandrails from \`tokens.json\`. Do not edit by hand; change \`tokens.json\` and regenerate.

- Use these tokens for every colour, spacing, radius, font, shadow and motion value.
- Never write raw hex, rgb or hsl colours, or px values for spacing and radius.
- Prefer role tokens (values like \`{color.black.900}\`) over raw scale steps.
- If no token fits, ask before adding a new value.
- Before writing or changing styles, read \`design/tokens.md\` for values and usage notes.

### Tokens

- Colour: \`color.{ink,…,danger}\`
- Typography: \`font.{sans,mono}\`
- Spacing: \`spacing.{1,2,4,8}\`
- Radius: \`radius.{sm,md,full}\`
- Shadow: \`shadow.card\`
- Motion: duration: \`duration.fast\`
- Motion: easing: \`easing.standard\`
<!-- brandrails:end -->
"
`;
