exports[`react-tailwind example > writes the AGENTS.md design section 1`] = `
"<!-- brandrails:start -->
## Design system

Generated by Brandrails from \`tokens.json\`. Do not edit by hand; change \`tokens.json\` and regenerate.

- Use these tokens for every colour, spacing, radius, font, shadow and motion value.
- Never write raw hex, rgb or hsl colours, or px values for spacing and radius.
- If no token fits, ask before adding a new value.

### Colour

| Token | Value | Notes |
| --- | --- | --- |
| \`color.ink\` | \`#1c1917\` |  |
| \`color.ink-muted\` | \`#57534e\` |  |
| \`color.surface\` | \`#ffffff\` |  |
| \`color.surface-raised\` | \`#f5f5f4\` |  |
| \`color.border\` | \`#e7e5e4\` |  |
| \`color.accent\` | \`#4f46e5\` |  |
| \`color.accent-hover\` | \`#4338ca\` |  |
| \`color.danger\` | \`#dc2626\` |  |

### Typography

| Token | Value | Notes |
| --- | --- | --- |
| \`font.sans\` | \`"Inter", system-ui, sans-serif\` |  |
| \`font.mono\` | \`"JetBrains Mono", ui-monospace, monospace\` |  |

### Spacing

| Token | Value | Notes |
| --- | --- | --- |
| \`spacing.1\` | \`0.25rem\` |  |
| \`spacing.2\` | \`0.5rem\` |  |
| \`spacing.4\` | \`1rem\` |  |
| \`spacing.8\` | \`2rem\` |  |

### Radius

| Token | Value | Notes |
| --- | --- | --- |
| \`radius.sm\` | \`4px\` |  |
| \`radius.md\` | \`8px\` |  |
| \`radius.full\` | \`9999px\` |  |

### Shadow

| Token | Value | Notes |
| --- | --- | --- |
| \`shadow.card\` | \`0 1px 2px rgb(0 0 0 / 0.06), 0 1px 3px rgb(0 0 0 / 0.1)\` |  |

### Motion: duration

| Token | Value | Notes |
| --- | --- | --- |
| \`duration.fast\` | \`120ms\` |  |

### Motion: easing

| Token | Value | Notes |
| --- | --- | --- |
| \`easing.standard\` | \`cubic-bezier(0.2, 0, 0, 1)\` |  |
<!-- brandrails:end -->
"
`;
